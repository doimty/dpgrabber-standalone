<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_shop_id" />

        <EditText
            android:id="@+id/shopIdInput"
            style="@style/FieldInput"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_request_timeout" />

        <EditText
            android:id="@+id/requestTimeoutInput"
            style="@style/FieldInput"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_seen_ttl" />

        <EditText
            android:id="@+id/seenTtlInput"
            style="@style/FieldInput"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            style="@style/SectionTitle"
            android:text="加解密密钥" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_hint_keys"
            android:textSize="13sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_key" />

        <EditText
            android:id="@+id/aesKeyInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_iv" />

        <EditText
            android:id="@+id/aesIvInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_key_alt" />

        <EditText
            android:id="@+id/aesKeyAltInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_iv_alt" />

        <EditText
            android:id="@+id/aesIvAltInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_verify_tls"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/verifyTlsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/saveAdvancedButton"
            style="@style/PrimaryButton"
            android:text="@string/btn_save_settings" />
    </LinearLayout>
</ScrollView>
