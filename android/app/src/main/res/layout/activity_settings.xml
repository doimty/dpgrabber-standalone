<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_shop_id" />

        <EditText
            android:id="@+id/shopIdInput"
            style="@style/FieldInput"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_request_timeout" />

        <EditText
            android:id="@+id/requestTimeoutInput"
            style="@style/FieldInput"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_seen_ttl" />

        <EditText
            android:id="@+id/seenTtlInput"
            style="@style/FieldInput"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            style="@style/SectionTitle"
            android:text="加解密密钥" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_hint_keys"
            android:textSize="13sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_key" />

        <EditText
            android:id="@+id/aesKeyInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_iv" />

        <EditText
            android:id="@+id/aesIvInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_key_alt" />

        <EditText
            android:id="@+id/aesKeyAltInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_aes_iv_alt" />

        <EditText
            android:id="@+id/aesIvAltInput"
            style="@style/FieldInput"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_verify_tls"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/verifyTlsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="店铺等待秒数：每行 sid=秒" />
        <EditText android:id="@+id/shopWaitInput" style="@style/FieldInput" android:inputType="textMultiLine" android:minLines="4" />
        <TextView style="@style/FieldLabel" android:text="其他店铺全局等待秒数（0–120）" />
        <EditText android:id="@+id/globalWaitInput" style="@style/FieldInput" android:inputType="numberDecimal" />
        <TextView style="@style/FieldLabel" android:text="连续运行秒数（0 不限制；休息不是多账号轮换）" />
        <EditText android:id="@+id/runDurationInput" style="@style/FieldInput" android:inputType="numberDecimal" />
        <TextView style="@style/FieldLabel" android:text="休息秒数" />
        <EditText android:id="@+id/restDurationInput" style="@style/FieldInput" android:inputType="numberDecimal" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/autoStopSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="接单成功后自动停止（立即保存）" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/onlineAfterLoginSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="任务登录后上线（立即保存）" />
        <TextView style="@style/FieldLabel" android:text="当前仅支持单账号闭环；多账号轮换未实现。TLS 始终校验。" />
        <Button
            android:id="@+id/saveAdvancedButton"
            style="@style/PrimaryButton"
            android:text="@string/btn_save_settings" />
    </LinearLayout>
</ScrollView>
